# Gradle / Android 构建产物
.gradle/
.kotlin/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# 签名材料（仓库是公开的，这些东西只能待在仓库外）
*.jks
*.keystore
keystore.properties
keystore-debug.properties

# 构建期临时文件
*.log

# 真机核对截图（验证产物）
.verify/
.design-qa/
# 本地会话产物（真机原文 dump、截图、UI 层级，禁止入库）
.trae/
.video_agent/
.workbuddy/
# 录屏与逐帧导出的临时目录（本机 1.4G，全是过程产物）
.screenshots/
docs/screenshots/_*
# 参考应用截图：含真实姓名、教师名、学校与个人课表，永久不入库
docs/screenshots/ref-nav-*
docs/screenshots/ref-runtime-*
docs/screenshots/ref-nav-motion.*
*.dump

# 本机签名产物 / 发布附件
/SHA256SUMS.txt
showcode-*.apk

# 截图回归的中间产物；基准图在 app/src/test/screenshots/ 里，要进版本库。
app/build/outputs/roborazzi/

# Baseline Profile 的采集产物：基准清单在 app/src/main/baseline-prof.txt，那个进版本库。
baselineprofile/build/

# 发布前审查产物（/full-review 的六份报告）。仓库是公开的，报告里写着
# 导出组件的攻击面、自更新链路缺什么校验——这些不该跟着代码一起发出去。
.full-review/

# 官网：Vite 依赖与构建产物（源码在 site/src，素材在 site/public/assets）
site/node_modules/
site/dist/

# 官网交接快照（截图 + page.html，本地产物不入库）
site/docs/handoff/
