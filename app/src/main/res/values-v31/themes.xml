<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 强制闪烁屏：同一张前景 + 同一薄荷底色。
         和 values/themes.xml 保持逐项一致，只多两条 splash 属性。 -->
    <style name="Theme.ShowCode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:isLightTheme">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
