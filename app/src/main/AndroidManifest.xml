<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- 只在用户主动绑定平台账号后使用；不绑定时不发任何网络请求。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台静默同步要先确认「真的能出去」再决定跑不跑；这条是普通权限，不弹授权框。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 上面两条是「收」；这一条是「我们主动说话」。巡检提醒只在证实过推送盲区
         （用户手动录过件）之后才响，而且拒了会退化成进 App 时的一条常驻提示，不损失功能。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 身份码那屏要「从这台手机的 App 里选一个」并跳过去。targetSdk 30 起这是**包可见性**
         而不是权限问题：不声明就查不到别人的启动活动，症状是明明装了却说没装，而且不报错。
         声明的是启动器意图而不是逐个包名，因为这一格的对象本来就是「所有能打开的 App」。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- 直达链要按 scheme 问「这一家接不接」。不写这几条，resolveActivity 会对
             已装的 App 返回 null——被隔离的是查询，不是启动，所以症状同样是不报错。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="taobao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tbopen" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="pinduoduo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="cainiao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="openjd" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="xhsdiscover" />
        </intent>
    </queries>

    <application
        android:name=".ShowCodeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShowCode">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ShowCode.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统「文本选择菜单」：在别的 App 里长按选中一段（单号、取件通知的整段），
                 系统菜单里会出现「卡皮巴拉快递助手」，点一下直接落到手动导入、带着那段原文。
                 这条路不读屏、不要无障碍、不联网——它拿到的就是用户主动选中的那几个字。
                 文本只预填，不落库：要成为一张卡，仍然得过「保存」那一下。 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 长按图标的那六个入口。它们不经过 onboarding、不读库、不要权限：
                 这是 App 在「第一次装、什么都还没给」时仍然能用的唯一一条路。 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".data.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.PickupReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.WidgetBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.PickupNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".ui.tile.PickupTileService"
            android:description="@string/tile_description"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickup"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.PickupWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.showcode.widget.TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pickup_widget_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.ShowCode">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
